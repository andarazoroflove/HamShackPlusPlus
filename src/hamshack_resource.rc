#include <windows.h>

// Primary executable icon (Explorer, Desktop, Taskbar, Alt-Tab, Titlebar)
101 ICON "AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HamShack++ Amateur Radio Systems\0"
            VALUE "FileDescription",  "HamShack++ Native C++20 Unified Amateur Radio Suite (FLRig, FT8/FT4, JS8Call, CW, Winlink, IRC & MeshCore++)\0"
            VALUE "FileVersion",      "1.3.0.0\0"
            VALUE "InternalName",     "HamShack++\0"
            VALUE "OriginalFilename", "HamShack++.exe\0"
            VALUE "ProductName",      "HamShack++ Unified Communications Suite\0"
            VALUE "ProductVersion",   "1.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
